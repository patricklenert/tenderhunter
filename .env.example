# PostgreSQL
DATABASE_URL=postgresql://tenderhunter:tenderhunter@postgres:5432/tenderhunter

# API Keys (optional, for Firecrawl and OpenRouter integration)
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
# Z.AI (Small-Vendor-Tiefenanalyse, GLM-Modelle); Fallback: OpenRouter
ZAI_API_KEY=
# Tagesbudget in EUR für bezahlte OpenRouter-Modelle (z.B. Ling 3.0 Flash); Default: 0.1
LLM_PAID_DAILY_BUDGET_EUR=0.1
MCP_API_KEY=
# Comma-separated bearer keys that bypass the MCP daily tender quota (e.g. personal and agent); keep them secret.
MCP_UNLIMITED_API_KEY=
SAM_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@tenderhunter.us

# Stripe subscriptions (test mode first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_QUARTERLY=

# Set true only after the Meilisearch embedding provider is valid
MEILI_EMBEDDINGS_ENABLED=false

# Private company-evidence uploads
EVIDENCE_MAX_FILE_BYTES=26214400

# Optional official SBA SUB-Net listing URL override
SBA_SUBNET_URL=https://subnet.sba.gov/client/dsp_Landing.cfm

# U.S. opportunity ingestion
US_SCRAPE_INTERVAL_HOURS=24
SAM_LOOKBACK_DAYS=2
SAM_MAX_RECORDS=5000
SAM_SET_ASIDE=
US_PORTAL_MAX_PAGES=2

# Site URL (canonical domain for SEO: sitemaps, canonicals, OG metadata)
NEXT_PUBLIC_SITE_URL=https://palemaz.com

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://palemaz.com

# Google OAuth
# Register these exact redirect URIs in Google Cloud Console:
# https://palemaz.com/api/auth/callback/google
# http://localhost:3000/api/auth/callback/google
# http://localhost:3025/api/auth/callback/google (Docker)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Default tender sources (comma-separated keys or URLs)
DEFAULT_SOURCES=ted,dtvp,bund

# Obscura headless browser (CDP endpoint for all Playwright scraping;
# run `obscura serve --port 9222` locally or use the docker-compose service.
# Non-loopback binds require a 32-byte token; generate with `openssl rand -hex 32`.
OBSCURA_CDP_URL=ws://127.0.0.1:9222
OBSCURA_CDP_TOKEN=

# Worker settings
MAX_PDF_LINKS_PER_TENDER=20
DOCUMENT_REFRESH_HOURS=72
MAX_JOB_RETRIES=3
WORKER_POLL_SECONDS=3
WORKER_CONCURRENCY=2
MAX_PENDING_JOBS=5000
MAX_CRITICAL_JOB_AGE_MINUTES=30
PUBLIC_SCRAPE_INTERVAL_HOURS=48
PUBLIC_PAGINATION_PAGES=3
PUBLIC_CPV_CODES_PER_RUN=20

# Small-Vendor-Tender-Fokus: Nur diese Accounts sehen Filter, Hervorhebung
# und angepasstes Ranking (Mehrfacheinträge mit Komma trennen).
SMALL_VENDOR_MODE_EMAILS=patricklenert@gmail.com
