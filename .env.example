# PostgreSQL
DATABASE_URL=postgresql://tenderhunter:tenderhunter@postgres:5432/tenderhunter

# API Keys (optional, for Firecrawl and OpenRouter integration)
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
SAM_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@tenderhunter.us

# Stripe subscriptions (test mode first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_QUARTERLY=

# Set true only after the Meilisearch embedding provider is valid
MEILI_EMBEDDINGS_ENABLED=false

# Private company-evidence uploads
EVIDENCE_MAX_FILE_BYTES=26214400

# Optional official SBA SUB-Net listing URL override
SBA_SUBNET_URL=https://subnet.sba.gov/client/dsp_Landing.cfm

# U.S. opportunity ingestion
US_SCRAPE_INTERVAL_HOURS=24
SAM_LOOKBACK_DAYS=2
SAM_MAX_RECORDS=5000
SAM_SET_ASIDE=
US_PORTAL_MAX_PAGES=2

# Site URL (canonical domain for SEO: sitemaps, canonicals, OG metadata)
NEXT_PUBLIC_SITE_URL=https://palemaz.com

# Default tender sources (comma-separated keys or URLs)
DEFAULT_SOURCES=ted,dtvp,bund

# Worker settings
MAX_PDF_LINKS_PER_TENDER=5
MAX_JOB_RETRIES=3
WORKER_POLL_SECONDS=3
PUBLIC_SCRAPE_INTERVAL_HOURS=48
PUBLIC_PAGINATION_PAGES=3
PUBLIC_CPV_CODES_PER_RUN=20
